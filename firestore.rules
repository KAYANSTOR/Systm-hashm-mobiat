rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isEmployee() { 
      return isSignedIn() && (
        request.auth.token.email == 'jarallhalkboudi@gmail.com' ||
        exists(/databases/$(database)/documents/employees/$(request.auth.uid))
      ); 
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone', 'balance', 'type', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && (data.get('address', '') is string && data.get('address', '').size() <= 200)
        && data.balance is number
        && data.type in ['retail', 'wholesale']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /customers/{customerId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidId(customerId) && isValidCustomer(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmployee() && isValidId(customerId) && isValidCustomer(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isEmployee() && isValidId(customerId);
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'phone', 'balance', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (data.get('company', '') is string && data.get('company', '').size() <= 100)
        && data.phone is string && data.phone.size() <= 20
        && data.balance is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /suppliers/{supplierId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidId(supplierId) && isValidSupplier(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmployee() && isValidId(supplierId) && isValidSupplier(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isEmployee() && isValidId(supplierId);
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['code', 'name', 'category', 'unit', 'quantity', 'costPrice', 'sellingPrice', 'lastUpdated'])
        && data.code is string && data.code.size() > 0 && data.code.size() <= 50
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.category in ['fabric', 'thread', 'accessory', 'machine_part']
        && data.unit in ['meter', 'roll', 'piece', 'kg']
        && data.quantity is number
        && data.costPrice is number
        && data.sellingPrice is number
        && (data.get('color', '') is string && data.get('color', '').size() <= 50)
        && (data.get('supplierId', '') is string && data.get('supplierId', '').size() <= 128)
        && data.lastUpdated is timestamp;
    }

    match /inventory/{itemId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidId(itemId) && isValidInventoryItem(incoming())
        && incoming().lastUpdated == request.time;
      allow update: if isEmployee() && isValidId(itemId) && isValidInventoryItem(incoming())
        && incoming().lastUpdated == request.time;
      allow delete: if isEmployee() && isValidId(itemId);
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['invoiceNumber', 'type', 'partyId', 'date', 'subTotal', 'discount', 'total', 'paidAmount', 'remainingAmount', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.invoiceNumber is string && data.invoiceNumber.size() > 0 && data.invoiceNumber.size() <= 50
        && data.type in ['sale', 'purchase']
        && data.partyId is string && data.partyId.size() > 0 && data.partyId.size() <= 128
        && data.date is string && data.date.size() > 0 && data.date.size() <= 30
        && data.get('items', []) is list && data.get('items', []).size() >= 0 && data.get('items', []).size() <= 100
        && data.subTotal is number
        && data.discount is number
        && data.total is number
        && data.paidAmount is number
        && data.remainingAmount is number
        && data.status in ['paid', 'partial', 'unpaid']
        && data.createdBy is string && data.createdBy == request.auth.uid
        && (data.get('notes', '') is string && data.get('notes', '').size() <= 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /invoices/{invoiceId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidId(invoiceId) && isValidInvoice(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmployee() && isValidId(invoiceId) && isValidInvoice(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isEmployee() && isValidId(invoiceId);
    }

    function isValidVoucher(data) {
      return data.keys().hasAll(['voucherNumber', 'type', 'partyType', 'amount', 'date', 'paymentMethod', 'description', 'createdBy', 'createdAt', 'updatedAt'])
        && data.voucherNumber is string && data.voucherNumber.size() > 0 && data.voucherNumber.size() <= 50
        && data.type in ['receipt', 'payment', 'deferred']
        && data.partyType in ['customer', 'supplier', 'other']
        && (data.get('partyId', '') is string && data.get('partyId', '').size() <= 128)
        && data.amount is number
        && data.date is string && data.date.size() > 0 && data.date.size() <= 30
        && data.paymentMethod in ['cash', 'bank', 'check']
        && (data.get('referenceNumber', '') is string && data.get('referenceNumber', '').size() <= 100)
        && data.description is string && data.description.size() <= 500
        && data.createdBy is string && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /vouchers/{voucherId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidId(voucherId) && isValidVoucher(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmployee() && isValidId(voucherId) && isValidVoucher(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isEmployee() && isValidId(voucherId);
    }
  }
}
