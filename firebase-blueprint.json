{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "A customer of the factory",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 200 },
        "balance": { "type": "number" },
        "type": { "type": "string", "enum": ["retail", "wholesale"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "phone", "balance", "type", "createdAt", "updatedAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "A supplier of the factory",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "company": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "balance": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "phone", "balance", "createdAt", "updatedAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "An item in the factory's inventory",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["fabric", "thread", "accessory", "machine_part"] },
        "unit": { "type": "string", "enum": ["meter", "roll", "piece", "kg"] },
        "quantity": { "type": "number" },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "color": { "type": "string", "maxLength": 50 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "lastUpdated": { "type": "string" }
      },
      "required": ["code", "name", "category", "unit", "quantity", "costPrice", "sellingPrice", "lastUpdated"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "A sales or purchase invoice",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "enum": ["sale", "purchase"] },
        "partyId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string" },
        "items": { "type": "array" },
        "subTotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "partial", "unpaid"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["invoiceNumber", "type", "partyId", "date", "subTotal", "discount", "total", "paidAmount", "remainingAmount", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "Voucher": {
      "title": "Voucher",
      "description": "A payment or receipt voucher",
      "type": "object",
      "properties": {
        "voucherNumber": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "enum": ["receipt", "payment", "deferred"] },
        "partyType": { "type": "string", "enum": ["customer", "supplier", "other"] },
        "partyId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string", "enum": ["cash", "bank", "check"] },
        "referenceNumber": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["voucherNumber", "type", "partyType", "amount", "date", "paymentMethod", "description", "createdBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "customers": {
      "schema": "Customer",
      "description": "Collection of all customers"
    },
    "suppliers": {
      "schema": "Supplier",
      "description": "Collection of all suppliers"
    },
    "inventory": {
      "schema": "InventoryItem",
      "description": "Collection of all inventory items"
    },
    "invoices": {
      "schema": "Invoice",
      "description": "Collection of all invoices"
    },
    "vouchers": {
      "schema": "Voucher",
      "description": "Collection of all financial vouchers"
    }
  }
}
